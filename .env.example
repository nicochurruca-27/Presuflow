# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/presuflow_dev"

# ── Auth (Auth.js / NextAuth v5) ─────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
# URL base de la app, usada para armar links absolutos (emails, link público
# del presupuesto, sitemap, metadata). Solo se lee en el servidor, así que NO
# necesita el prefijo NEXT_PUBLIC_ (ese prefijo la expondría al navegador).
#
# Orden en el que se resuelve:
#   1. APP_URL                          (recomendada)
#   2. NEXT_PUBLIC_APP_URL              (compatibilidad, sigue funcionando)
#   3. VERCEL_PROJECT_PRODUCTION_URL    (Vercel la define sola, en producción)
#   4. VERCEL_URL                       (Vercel la define sola, en previews)
#   5. http://localhost:3000            (solo fuera de producción)
#
# En Vercel no hace falta definir ninguna: los pasos 3 y 4 alcanzan. Definí
# APP_URL cuando tengas un dominio propio. En producción, si lo que hay no es
# una URL http(s) válida, la app falla con un error claro en vez de generar
# links a localhost.
APP_URL="http://localhost:3000"

# ── AI provider (abstracted, see lib/ai/provider.ts) ────────
# Currently implemented: Anthropic Claude.
AI_PROVIDER="anthropic"
AI_API_KEY=""
# Optional. Defaults to a fast/cheap Claude model.
AI_MODEL="claude-haiku-4-5-20251001"

# ── Transactional email ─────────────────────────────────────
# Resend (https://resend.com). Opcional: sin esta key la app funciona igual
# y los emails no se envían. En desarrollo el cuerpo se imprime en consola
# (así se puede clickear el link de recuperación); en producción NO se
# imprime, porque ese cuerpo contiene el token de recuperación.
EMAIL_API_KEY=""
EMAIL_FROM="PresuFlow <no-reply@presuflow.app>"

# ── Self-hosting (opcional) ─────────────────────────────────
# Solo si levantás la app con `next start` fuera de Vercel (servidor propio o
# local). En Vercel, Auth.js confía en el host automáticamente y esta variable
# no hace falta. Sin ella, fuera de Vercel el login falla con "UntrustedHost".
# AUTH_TRUST_HOST="true"

# ── Admin panel ──────────────────────────────────────────────
# Comma-separated list of emails allowed into /admin.
ADMIN_EMAILS=""

# ── Payments (not activated without credentials) ────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MERCADOPAGO_ACCESS_TOKEN=""
