# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/presuflow_dev"

# ── Auth (Auth.js / NextAuth v5) ─────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
# Public base URL of the app (used to build absolute links: emails, quote links, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI provider (abstracted, see lib/ai/provider.ts) ────────
# Currently implemented: Anthropic Claude.
AI_PROVIDER="anthropic"
AI_API_KEY=""
# Optional. Defaults to a fast/cheap Claude model.
AI_MODEL="claude-haiku-4-5-20251001"

# ── Transactional email ─────────────────────────────────────
# Resend (https://resend.com). If empty, emails are logged to the
# console instead of sent — safe default for local development.
EMAIL_API_KEY=""
EMAIL_FROM="PresuFlow <no-reply@presuflow.app>"

# ── Admin panel ──────────────────────────────────────────────
# Comma-separated list of emails allowed into /admin.
ADMIN_EMAILS=""

# ── Payments (not activated without credentials) ────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MERCADOPAGO_ACCESS_TOKEN=""
